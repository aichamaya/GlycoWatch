<Application x:Class="GlycoWatch_version_prof.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <Color x:Key="CouleurPrimaire">#16A34A</Color>
        
        <Color x:Key="CouleurSecondaire">#0EA5E9</Color>
       

        <SolidColorBrush x:Key="BrushFondPage" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="BrushCarteFond" Color="White"/>
        <SolidColorBrush x:Key="BrushCarteBord" Color="#22000000"/>
        <SolidColorBrush x:Key="BrushTexteTitre" Color="#111827"/>
        <SolidColorBrush x:Key="BrushTexteNormal" Color="#374151"/>

      
        <Style x:Key="StyleCarte" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCarteFond}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushCarteBord}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="BoutonPrincipal" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource CouleurPrimaire}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        
        <Style x:Key="BoutonSecondaire" TargetType="Button"
               BasedOn="{StaticResource BoutonPrincipal}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

       
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexteTitre}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

       
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexteTitre}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

    </Application.Resources>
</Application>
