<Window x:Class="GlycoWatch_version_prof.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlycoWatch" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageFond}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Padding="10,6">
            <DockPanel LastChildFill="False">

                <!-- Titre appli -->
                <TextBlock Text="GlycoWatch"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <Button Content="Accueil"
                            Click="BtnAccueil_Click"
                            Style="{StaticResource BtnGhost}"/>

                    <Button Content="Profil"
                            Click="BtnProfil_Click"
                            Style="{StaticResource BtnGhost}"/>

                    <Button Content="Mesures"
                            Click="BtnMesures_Click"
                            Style="{StaticResource BtnGhost}"/>

                    <Button Content="Tendances"
                            Click="BtnTendances_Click"
                            Style="{StaticResource BtnGhost}"/>

                    <Button Content="Historique"
                            Click="BtnHistorique_Click"
                            Style="{StaticResource BtnGhost}"/>

                    <Button Content="Déconnexion"
                            Click="BtnLogout_Click"
                            Style="{StaticResource BtnGhost}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        
        <Frame x:Name="FramePrincipal"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource PageFond}"/>
    </Grid>
</Window>
