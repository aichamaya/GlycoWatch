<Window x:Class="GlycoWatch_version_prof.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="GlycoWatch"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Fond général -->
        <SolidColorBrush x:Key="PageFond" Color="#F5F7FF"/>

        <!-- Gradient haut -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DDE8FF"  Offset="0.0"/>
            <GradientStop Color="#DDE8FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Bouton de navigation (fantôme/blanc) -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <!-- Effet hover -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource PageFond}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Padding="10,6">
            <DockPanel LastChildFill="False">

                <!-- Logo / Titre -->
                <TextBlock Text="GlycoWatch"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="Black"
                           Margin="0,0,24,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <!-- Boutons -->
                <StackPanel Orientation="Horizontal" 
                            DockPanel.Dock="Left"  >

                    <Button Content="Accueil"
                            Click="BtnAccueil_Click" 
                            Margin="4"
                            />

                    <Button Content="Profil"
                            Click="BtnProfil_Click"
                             Margin="4"
                            />

                    <Button Content="Mesures"
                            Click="BtnMesures_Click" Margin="4"/>

                    <Button Content="Tendances"
                            Click="BtnTendances_Click" Margin="5"
                            />

                    <Button Content="Historique"
                            Click="BtnHistorique_Click"
                            Margin="5"
                            />

                    <Button Content="Déconnexion"
                            Click="BtnLogout_Click"
                            Margin="5"
                            />
                    <Button Content="Tutoriel"
                        Click="BtnTutoriel_Click"
                            Margin="5"
                         />


                </StackPanel>

            </DockPanel>
        </Border>


        <!-- ======== CONTENU PRINCIPAL ======== -->
        <Frame x:Name="FramePrincipal"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource PageFond}"/>
    </Grid>
</Window>
