<Page x:Class="GlycoWatch_version_prof.Views.MeasuresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mesures">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- barre titre + retour -->
            <RowDefinition Height="Auto"/>
            <!-- formulaire ajout -->
            <RowDefinition Height="Auto"/>
            <!-- filtres -->
            <RowDefinition Height="*"/>
            <!-- tableau -->
        </Grid.RowDefinitions>

        <!-- Barre supérieure avec bouton Retour -->
        <StackPanel Orientation="Horizontal">
            <Button Content="← Retour" Click="Back_Click"/>
            <TextBlock Text="Mesures" FontSize="22" FontWeight="Bold" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Formulaire d'ajout -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Gly (mmol/L)" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtGly" Width="80" Margin="6,0,0,0"/>

            <TextBlock Text="Date" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpDate" Width="150"/>

            <TextBlock Text="Heure" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTime" Width="70" Text="12:00"/>

            <TextBlock Text="Repas" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtRepas" Width="120" ToolTip="Ex: Avant repas, Déjeuner..."/>

            <TextBlock Text="Activité" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtActivite" Width="150" ToolTip="Ex: Marche 20 min"/>

            <Button Content="Ajouter" Margin="12,0,0,0" Click="Add_Click"/>
            <Button Content="Modifier sélection" Margin="12,0,0,0" Click="EditSelected_Click"/>
            <Button Content="Supprimer sélection" Margin="6,0,0,0" Click="DeleteSelected_Click"/>


        </StackPanel>

        <!-- Filtres -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="De" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpFrom" Width="150" Margin="6,0,0,0"/>

            <TextBlock Text="À" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpTo" Width="150"/>

            <TextBlock Text="Repas contient" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtFilterRepas" Width="100"/>

            <TextBlock Text="Activité contient" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtFilterActivite" Width="110"/>

            <Button Content="Filtrer" Margin="12,0,0,0" Click="Filter_Click"/>
            <Button Content="Réinitialiser" Margin="6,0,0,0" Click="ClearFilters_Click"/>
        </StackPanel>

        <!-- Tableau -->
        <DataGrid x:Name="Grid" Grid.Row="3" Margin="0,12,0,0"
              AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quand" Binding="{Binding Quand}" Width="*" />
                <DataGridTextColumn Header="Gly" Binding="{Binding Glycemie}" Width="*" />
                <DataGridTextColumn Header="Repas" Binding="{Binding Repas}" Width="*" />
                <DataGridTextColumn Header="Activité" Binding="{Binding Activite}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
