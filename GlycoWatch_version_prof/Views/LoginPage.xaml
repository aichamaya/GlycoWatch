<Page x:Class="GlycoWatch_version_prof.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Connexion">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Connexion" FontSize="28" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Pseudo"/>
            <TextBox x:Name="TxtPseudo"/>

            <TextBlock Text="Mot de passe" Margin="0,12,0,0"/>
            <PasswordBox x:Name="TxtPassword"/>

            <Button Content="Se connecter" Margin="0,16,0,0" Click="BtnLogin_Click"/>
            <TextBlock x:Name="LblError" Foreground="Crimson"/>

            <Separator Margin="0,12,0,12"/>
            <TextBlock>
        <Run Text="Pas de compte ? " />
        <Hyperlink Click="GoRegister">Créer un compte</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
