<Page x:Class="GlycoWatch_version_prof.Views.PageConnexion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Connexion" FontFamily="Segoe UI" FontSize="14">

    <Grid>

        <!-- BACKGROUND = image -->
        <Grid.Background>
            
            <ImageBrush ImageSource="/Images/iamge-1.jpg"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Grid.Background>

        
        <Rectangle Fill="#33000000"/>

        <!-- Card -->
        <Border Width="520"
                Background="White"
                CornerRadius="16"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#22000000"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Connexion" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="Pseudo" Margin="0,8,0,4"/>
                <TextBox x:Name="TxtPseudo" Height="34"/>

                <TextBlock Text="Mot de passe" Margin="0,12,0,4"/>
                <PasswordBox x:Name="TxtPassword" Height="34"/>

                <TextBlock x:Name="LblError" Foreground="#C1272D" Margin="0,10,0,0"/>

                <Button Content="Se connecter"
                        Height="42" Margin="0,12,0,0"
                        Background="#16A34A" Foreground="White"
                        Click="BtnLogin_Click"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Pas de compte ? " VerticalAlignment="Center"/>
                    <Button Content="Créer un compte"
                            Padding="10,4"
                            Background="#F3F4F6" Foreground="#111"
                            Click="GoInscription_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
