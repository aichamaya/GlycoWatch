<Page x:Class="GlycoWatch_version_prof.Views.PageMesures"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mesures"
      FontFamily="Segoe UI"
      FontSize="14" >

    <Page.Resources>
        <!-- Couleurs -->
        <SolidColorBrush x:Key="FondPage" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="VertPrimaire" Color="#16A34A"/>
        <SolidColorBrush x:Key="GrisClair" Color="#EEEEEE"/>

        <!-- Styles -->
        <Style x:Key="BoutonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VertPrimaire}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="BoutonSecondaire" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GrisClair}"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource FondPage}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Content="← Retour"
                        Click="Retour_Click"
                        Style="{StaticResource BoutonSecondaire}"
                        Margin="0,0,8,0"/>
                <TextBlock Text="Mesures"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Formulaire + message de statut -->
            <StackPanel Grid.Row="1">
                <Border Background="White"
                        CornerRadius="10"
                        Padding="16"
                        BorderBrush="#22000000"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Champs formulaire -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Glycémie (mmol/L)" Width="140"/>
                                <TextBox x:Name="ChampGlycemie" Width="120"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Date" Width="140"/>
                                <DatePicker x:Name="ChampDate" Width="150"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Heure (HH:MM)" Width="140"/>
                                <TextBox x:Name="ChampHeure" Width="80"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Contexte repas" Width="140"/>
                                <TextBox x:Name="ChampRepas" Width="260"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <TextBlock Text="Activité" Width="140"/>
                                <TextBox x:Name="ChampActivite" Width="260"/>
                            </StackPanel>
                        </Grid>

                        <!-- Boutons -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Content="Ajouter / Enregistrer"
                                    Click="AjouterOuEnregistrer_Click"
                                    />

                            <Button Content="Modifier la sélection"
                                    Click="ModifierSelection_Click"
                                    
                                    Margin="0,8,0,0"/>

                            <Button Content="Supprimer la sélection"
                                    Click="SupprimerSelection_Click"
                                    
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Message d'état (succès / erreur) -->
                <TextBlock x:Name="LblEtatMesures"
                           Margin="4,6,0,0"
                           Foreground="DarkGreen"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Tableau -->
            <Border Grid.Row="2"
                    Margin="0,12,0,12"
                    Background="White"
                    CornerRadius="10"
                    Padding="8"
                    BorderBrush="#22000000"
                    BorderThickness="1">

                <DataGrid x:Name="Grille"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quand"
                                            Binding="{Binding DateMesure, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Gly"
                                            Binding="{Binding Glycemie}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Repas"
                                            Binding="{Binding ContexteRepas}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Activité"
                                            Binding="{Binding Activite}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Filtres -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="12"
                    BorderBrush="#22000000"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Filtrer les mesures" FontWeight="Bold" Margin="0,0,0,8"/>

                    <UniformGrid Columns="4" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Depuis la date"/>
                            <DatePicker x:Name="FiltreDepuis"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Jusqu'à la date"/>
                            <DatePicker x:Name="FiltreJusqua"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Repas contient"/>
                            <TextBox x:Name="FiltreRepas"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Activité contient"/>
                            <TextBox x:Name="FiltreActivite"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Appliquer les filtres"
                                Click="Filtrer_Click"
                                />
                        <Button Content="Réinitialiser"
                                Click="ReinitialiserFiltres_Click"
                                />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
