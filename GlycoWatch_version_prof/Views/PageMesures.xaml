<Page x:Class="GlycoWatch_version_prof.Views.PageAccueil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Accueil"
      FontFamily="Segoe UI"
      FontSize="14">

    <Page.Resources>
        <!-- Couleurs -->
        <SolidColorBrush x:Key="VertPrimaire" Color="#16A34A"/>
        <SolidColorBrush x:Key="CarteFond" Color="White"/>
        <SolidColorBrush x:Key="CarteInterieur" Color="#FAFAFA"/>

        <!-- Style bouton principal -->
        <Style x:Key="BtnPrincipal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VertPrimaire}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Style cartes d'indicateurs -->
        <Style x:Key="CarteIndicator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CarteInterieur}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#20000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>

        <!-- Image de fond -->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/diabete-type2.jpg"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Overlay sombre pour lisibilité -->
        <Rectangle Fill="#88000000"/>

        <!-- Contenu principal -->
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Text="GlycoWatch"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,8"/>

            <!-- Message de bienvenue -->
            <TextBlock x:Name="LblBienvenueAccueil"
                       Grid.Row="1"
                       FontSize="22"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- Carte "dashboard" -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="20"
                    Padding="28"
                    BorderBrush="#33000000"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Boutons de navigation -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">
                        <Button Content="Mesures"
                                Click="AllerMesures_Click"
                                Style="{StaticResource BtnPrincipal}"/>

                        <Button Content="Profil"
                                Click="AllerProfil_Click"
                                Style="{StaticResource BtnPrincipal}"/>

                        <Button Content="Tendances"
                                Click="AllerTendances_Click"
                                Style="{StaticResource BtnPrincipal}"/>
                    </StackPanel>

                    <!-- Indicateurs (3 cartes) -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <!-- Carte nb mesures -->
                        <Border Style="{StaticResource CarteIndicator}">
                            <StackPanel>
                                <TextBlock Text="Mesures (7 jours)"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblNbMesures"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Carte moyenne -->
                        <Border Style="{StaticResource CarteIndicator}">
                            <StackPanel>
                                <TextBlock Text="Moyenne (7 jours)"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblMoyenne7"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Carte % en zone -->
                        <Border Style="{StaticResource CarteIndicator}">
                            <StackPanel>
                                <TextBlock Text="% en zone (7 jours)"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblPctZone7"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
