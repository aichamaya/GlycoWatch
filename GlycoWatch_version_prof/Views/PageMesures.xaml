<Page x:Class="GlycoWatch_version_prof.Views.PageMesures"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mesures"
      FontFamily="Segoe UI" FontSize="14">

    <Page.Resources>
        <SolidColorBrush x:Key="CouleurBordure" Color="#22000000"/>
        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Width" Value="260"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Width" Value="260"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F7F7F7">
        <Grid Margin="16" Width="880">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="← Retour" Click="Retour_Click"/>
                <TextBlock Text="Mesures" FontSize="22" FontWeight="Bold" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Formulaire vertical -->
            <Border Grid.Row="1" Style="{StaticResource Carte}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Glycémie (mmol/L)"/>
                    <TextBox x:Name="ChampGlycemie" ToolTip="Ex : 6.2"/>

                    <TextBlock Text="Date de la mesure"/>
                    <DatePicker x:Name="ChampDate"/>

                    <TextBlock Text="Heure de la mesure (HH:MM)"/>
                    <TextBox x:Name="ChampHeure" Text="12:00" Width="120"/>

                    <TextBlock Text="Contexte repas (ex : Avant repas, Déjeuner...)"/>
                    <TextBox x:Name="ChampRepas" Width="340"/>

                    <TextBlock Text="Activité (ex : Marche 20 min)"/>
                    <TextBox x:Name="ChampActivite" Width="340"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Ajouter / Enregistrer" Click="AjouterOuEnregistrer_Click"/>
                        <Button Content="Modifier la sélection" Click="ModifierSelection_Click"/>
                        <Button Content="Supprimer la sélection" Click="SupprimerSelection_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Filtres -->
            <Border Grid.Row="2" Style="{StaticResource Carte}" Margin="0,12,0,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Filtrer les mesures" FontSize="16" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Depuis la date"/>
                            <DatePicker x:Name="FiltreDepuis"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Jusqu'à la date"/>
                            <DatePicker x:Name="FiltreJusqua"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Repas contient"/>
                            <TextBox x:Name="FiltreRepas" Width="220"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Activité contient"/>
                            <TextBox x:Name="FiltreActivite" Width="220"/>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Appliquer les filtres" Click="Filtrer_Click"/>
                        <Button Content="Réinitialiser" Click="ReinitialiserFiltres_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tableau -->
            <Border Grid.Row="3" Style="{StaticResource Carte}" Margin="0,12,0,0">
                <DataGrid x:Name="Grille"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Vertical"
                  RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quand" Binding="{Binding DateMesure}" Width="2*"/>
                        <DataGridTextColumn Header="Gly (mmol/L)" Binding="{Binding Glycemie}" Width="*"/>
                        <DataGridTextColumn Header="Repas" Binding="{Binding ContexteRepas}" Width="*"/>
                        <DataGridTextColumn Header="Activité" Binding="{Binding Activite}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>
