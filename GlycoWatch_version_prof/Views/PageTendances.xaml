<Page x:Class="GlycoWatch_version_prof.Views.PageTendances"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:oxy="http://oxyplot.org/wpf"
      Title="Tendances" FontFamily="Segoe UI" FontSize="14">
    

    <Grid Background="#F7F7F7">
        <Grid Margin="16" Width="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Orientation="Horizontal">
                <Button Content="← Retour" Click="Retour_Click" Margin="0,0,8,0"/>
                <TextBlock Text="Tendances glycémiques"
                           FontSize="22" FontWeight="Bold"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Période :" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbPeriode"
                              Width="160"
                              SelectionChanged="Periode_Changee">
                        <ComboBoxItem Content="7 derniers jours" IsSelected="True"/>
                        <ComboBoxItem Content="30 derniers jours"/>
                    </ComboBox>
                    <Button Content="Actualiser"
                            Click="Actualiser_Click"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Statistiques -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="16"
                    BorderBrush="#22000000"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Moyenne" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblMoyenne" FontSize="20"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Min / Max" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblMinMax" FontSize="20"/>
                    </StackPanel>
                    <!--<StackPanel>
                        <TextBlock x:Name="LblConseils" TextWrapping= "Wrap" Foreground="#444" LineHeight="20"/>
                               
                    </StackPanel>-->
                  

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="% en zone" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblDansCible" FontSize="20"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Nb mesures" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblNb" FontSize="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Courbe -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="16"
                    BorderBrush="#22000000"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Courbe des glycémies"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <oxy:PlotView x:Name="PlotCourbes"
                                  Height="260" />
                </StackPanel>
            </Border>

            <!-- Conseils -->
            <Border Grid.Row="3"
                    Margin="0,12,0,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="12"
                    BorderBrush="#22000000"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Conseils"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="LblConseils"
                               TextWrapping="Wrap"
                               Foreground="#444"
                               LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>