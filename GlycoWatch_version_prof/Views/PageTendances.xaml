<Page x:Class="GlycoWatch_version_prof.Views.PageTendances"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:oxy="http://oxyplot.org/wpf"
      Title="Tendances glycémiques">

    <Grid Background="#FFF5F5F5" Margin="10">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="Auto"/>
            <!-- Courbe -->
            <RowDefinition Height="*"/>
            <!-- Conseils -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête : retour + titre + période -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <Button Content="← Retour"
                    Width="100"
                    Margin="0,0,10,0"
                    Padding="6,3"
                    Click="Retour_Click"
                    DockPanel.Dock="Left"
                    Background="White"
                    BorderBrush="#2D7FF9"
                    BorderThickness="1"
                    Foreground="#2D7FF9"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>

            <TextBlock Text="Tendances glycémiques"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Margin="10,0,0,0">
                <TextBlock Text="Période :"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <ComboBox x:Name="CmbPeriode"
                          Width="150"
                          SelectedIndex="0"
                          SelectionChanged="Periode_Changee"
                          Margin="0,0,5,0">
                    <ComboBoxItem Content="7 derniers jours" />
                    <ComboBoxItem Content="30 derniers jours" />
                </ComboBox>

                <Button Content="Actualiser"
                        Padding="6,3"
                        Click="Actualiser_Click"
                        
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- Bloc stats -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,10"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Moyenne -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Moyenne"
                               FontWeight="Bold"
                               Margin="0,0,0,5"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMoyenne"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Min / Max -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Min / Max"
                               FontWeight="Bold"
                               Margin="0,0,0,5"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMinMax"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- % en zone -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="% en zone"
                               FontWeight="Bold"
                               Margin="0,0,0,5"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPourcZone"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Nb mesures -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Nb mesures"
                               FontWeight="Bold"
                               Margin="0,0,0,5"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtNbMesures"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bloc courbe -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,10"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Courbe des glycémies"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <oxy:PlotView x:Name="PlotCourbes"
                              Grid.Row="1"
                              Margin="0"/>
            </Grid>
        </Border>

        <!-- Bloc conseils -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,0"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Conseils"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="LblConseils"
                           TextWrapping="Wrap"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
