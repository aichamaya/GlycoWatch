<Page x:Class="GlycoWatch_version_prof.Views.PageInscription"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inscription" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Créer un compte" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Width="360">
            <TextBlock Text="Nom complet"/>
            <TextBox x:Name="TxtNom" Margin="0,4,0,12"/>

            <TextBlock Text="Pseudo (utilisé pour se connecter)"/>
            <TextBox x:Name="TxtPseudo" Margin="0,4,0,12"/>

            <TextBlock Text="Date de naissance"/>
            <DatePicker x:Name="DpNaissance" Margin="0,4,0,12"/>

            <TextBlock Text="Mot de passe"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,4,0,16"/>

            <Button Content="Créer le compte" Click="BtnCreer_Click" Height="34"/>
            <TextBlock x:Name="LblInfo" Margin="0,12,0,0" Foreground="Crimson"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Déjà un compte ? " VerticalAlignment="Center"/>
                <Button Content="Se connecter" Click="GoConnexion_Click" Padding="4,2" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
