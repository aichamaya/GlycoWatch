<Page x:Class="GlycoWatch_version_prof.Views.PageInscription"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inscription"
      FontFamily="Segoe UI"
      FontSize="14">

    <Page.Resources>
        <!-- Couleurs -->
        <SolidColorBrush x:Key="FondPage" Color="#F5F7FF"/>
        <SolidColorBrush x:Key="BleuPrimaire" Color="#2D7FF9"/>
        <SolidColorBrush x:Key="BoutonGris" Color="#EEEEEE"/>

        <!-- Style du bouton principal -->
        <Style x:Key="BoutonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BleuPrimaire}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- Bouton lien / secondaire -->
        <Style x:Key="BoutonLien" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BoutonGris}"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource FondPage}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Text="Créer un compte"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,24"/>

            <!-- Carte -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Width="420"
                    HorizontalAlignment="Left">
                <StackPanel>

                    <!-- Nom complet -->
                    <TextBlock Text="Nom complet"/>
                    <TextBox x:Name="TxtNom" Margin="0,4,0,16"/>

                    <!-- Pseudo -->
                    <TextBlock Text="Pseudo (utilisé pour se connecter)"/>
                    <TextBox x:Name="TxtPseudo" Margin="0,4,0,16"/>

                    <!-- Naissance -->
                    <TextBlock Text="Date de naissance"/>
                    <DatePicker x:Name="DpNaissance" Margin="0,4,0,16"/>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe"/>
                    <PasswordBox x:Name="TxtPassword" Margin="0,4,0,16"/>

                    <!-- Bouton principal -->
                    <Button Content="Créer le compte"
                            Click="BtnCreer_Click"
                            Style="{StaticResource BoutonPrincipal}"/>

                    <!-- Message d'information -->
                    <TextBlock x:Name="LblInfo"
                               Margin="0,12,0,0"
                               Foreground="Crimson"
                               TextWrapping="Wrap"/>

                    <!-- Lien vers connexion -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Déjà un compte ?" VerticalAlignment="Center"/>
                        <Button Content="Se connecter"
                                Style="{StaticResource BoutonLien}"
                                Click="GoConnexion_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
