<Page x:Class="GlycoWatch_version_prof.Views.PageAccueil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Accueil" FontFamily="Segoe UI" FontSize="14">

    <Grid>
        <Image Source="/Images/diabete-type2.jpg"></Image>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="GlycoWatch" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="LblBienvenueAccueil" Grid.Row="1" FontSize="18" Margin="0,0,0,16"/>

            <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="20"
              BorderBrush="#22000000" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.22"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Raccourcis -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Mesures"   Click="AllerMesures_Click"   Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Profil"    Click="AllerProfil_Click"    Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Tendances" Click="AllerTendances_Click"              Padding="14,8"/>
                    </StackPanel>

                    <!-- Indicateurs -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#FAFAFA" CornerRadius="10" Padding="16" BorderBrush="#14000000" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Mesures (7j)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblNbMesures" FontSize="22" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="10" Padding="16" BorderBrush="#14000000" BorderThickness="1" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="Moyenne (7j)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblMoyenne7" FontSize="22" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FAFAFA" CornerRadius="10" Padding="16" BorderBrush="#14000000" BorderThickness="1" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="% en zone (7j)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblPctZone7" FontSize="22" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
