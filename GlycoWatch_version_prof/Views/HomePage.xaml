<Page x:Class="GlycoWatch_version_prof.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Accueil">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtWelcome" FontSize="26" FontWeight="Bold"/>
        <WrapPanel Margin="0,16,0,0">
            <Button Content="Profil"   Width="100" Margin="0,0,12,0" Click="GoProfil"/>
            <Button Content="Mesures"  Width="100" Margin="0,0,12,0" Click="GoMesures"/>
            <Button Content="Déconnexion" Width="100" Click="Logout"/>
        </WrapPanel>
    </StackPanel>
</Page>
