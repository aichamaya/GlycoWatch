<Page x:Class="GlycoWatch_version_prof.Views.PageProfil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Profil"
      FontFamily="Segoe UI" FontSize="14">

    <Page.Resources>
        <SolidColorBrush x:Key="ColBordure" Color="#22000000"/>
        <SolidColorBrush x:Key="ColTextePale" Color="#66000000"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="140"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Width" Value="260"/>
        </Style>
        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F5FAF7">
        <StackPanel Margin="16" Width="720">

            <StackPanel Orientation="Horizontal">
                <Button Content="← Retour" Click="Retour_Click"/>
                <TextBlock Text="Mon profil" FontSize="24" FontWeight="Bold" Margin="12,0,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Carte}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom complet" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ChampNom" IsReadOnly="True"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pseudo" Margin="0,8,0,0" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ChampPseudo" Margin="0,8,0,0" IsReadOnly="True"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Date de naissance" Margin="0,8,0,0" VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" x:Name="ChampNaissance" Margin="0,8,0,0" IsEnabled="False"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cible min (mmol/L)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ChampCibleMin" Width="120"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cible max (mmol/L)" Margin="0,8,0,0" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ChampCibleMax" Margin="0,8,0,0" Width="120"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Unité" Margin="0,8,0,0" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ChampUnite" Margin="0,8,0,0" Width="120" IsReadOnly="True"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Enregistrer" Click="Enregistrer_Click"/>
                <TextBlock x:Name="LblInfo" Margin="12,4,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
