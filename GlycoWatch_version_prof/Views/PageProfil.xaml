<Page x:Class="GlycoWatch_version_prof.Views.PageProfil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctrls="clr-namespace:GlycoWatch_version_prof.Views.Controls"
      Title="Profil" FontFamily="Segoe UI" FontSize="14">

    <Grid Style="{StaticResource PageFond}">
        <Grid Margin="16" Width="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- En-tête -->
            <Border Grid.ColumnSpan="2" Background="{StaticResource HeaderGradient}"
                    CornerRadius="10" Padding="12"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="← Retour" Click="Retour_Click"
                            Style="{StaticResource BtnGhost}" Margin="0,0,8,0"/>
                    <TextBlock Text="Mon profil" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Formulaire profil -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StyleCarte}" Margin="0,12,12,0">
                <StackPanel>
                    <TextBlock Text="Informations" Style="{StaticResource H2}" Margin="0,0,0,8"/>

                    <TextBlock Text="Nom complet"/>
                    <TextBox x:Name="ChampNom" Height="32"/>

                    <TextBlock Text="Pseudo" Margin="0,8,0,0"/>
                    <TextBox x:Name="ChampPseudo" Height="32" IsReadOnly="True"/>

                    <TextBlock Text="Date de naissance" Margin="0,8,0,0"/>
                    <DatePicker x:Name="ChampNaissance" Height="32"/>

                    <Separator Margin="0,8,0,8"/>

                    <TextBlock Text="Cibles glycémiques" Style="{StaticResource H2}"/>

                    <WrapPanel ItemWidth="200" ItemHeight="56" Margin="0,6,0,0">
                        <StackPanel Width="200">
                            <TextBlock Text="Cible min (mmol/L)"/>
                            <TextBox x:Name="ChampCibleMin" Height="30"/>
                        </StackPanel>
                        <StackPanel Width="200">
                            <TextBlock Text="Cible max (mmol/L)"/>
                            <TextBox x:Name="ChampCibleMax" Height="30"/>
                        </StackPanel>
                        <StackPanel Width="200">
                            <TextBlock Text="Unité"/>
                            <TextBox x:Name="ChampUnite" Height="30" Text="mmol/L"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock x:Name="LblInfo" Foreground="#C1272D" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Enregistrer"
                                Click="Enregistrer_Click"
                                Style="{StaticResource BtnPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Zone Conseil à droite --><!--
            <ctrls:HealthAdvicePanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,0"/>-->
        </Grid>
    </Grid>
</Page>
