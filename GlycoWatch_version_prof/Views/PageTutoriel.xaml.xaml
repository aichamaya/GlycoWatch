<Page x:Class="GlycoWatch_version_prof.Views.PageTutoriel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tutoriel"
      FontFamily="Segoe UI"
      FontSize="14">

    <Grid Background="#F5F5F5" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="← Retour"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Retour_Click"/>
            <TextBlock Text="Tutoriel GlycoWatch"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1"
                Background="Black"
                CornerRadius="10"
                BorderBrush="#22000000"
                BorderThickness="1">
            <MediaElement x:Name="VideoTutoriel"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"/>
        </Border>


        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left">
            <Button Content="▶ Lecture"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="Play_Click"/>
            <Button Content="⏸ Pause"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="Pause_Click"/>
            <Button Content="⏮ Recommencer"
                    Width="120"
                    Click="Restart_Click"/>

            <TextBlock x:Name="TxtInfo"
                       Margin="16,4,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
