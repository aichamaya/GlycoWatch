<Page x:Class="GlycoWatch_version_prof.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Créer un compte">
    <StackPanel Margin="16">
        <TextBlock Text="Créer un compte (Patient)" FontSize="28" FontWeight="Bold"/>

        <TextBlock Text="Nom complet" Margin="0,16,0,0"/>
        <TextBox x:Name="TxtNom"/>

        <TextBlock Text="Pseudo" Margin="0,12,0,0"/>
        <TextBox x:Name="TxtPseudo"/>

        <TextBlock Text="Date de naissance" Margin="0,12,0,0"/>
        <DatePicker x:Name="DpDob"/>

        <TextBlock Text="Mot de passe" Margin="0,12,0,0"/>
        <PasswordBox x:Name="TxtPass"/>

        <Button Content="Créer le compte" Margin="0,16,0,0" Click="BtnRegister_Click"/>
        <TextBlock x:Name="LblError" Foreground="Crimson"/>

        <Separator Margin="0,12,0,12"/>
        <TextBlock>
      <Run Text="Déjà un compte ? " />
      <Hyperlink Click="GoLogin">Se connecter</Hyperlink>
        </TextBlock>
    </StackPanel>
</Page>
